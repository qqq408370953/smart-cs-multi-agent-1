# HTTP 监听地址。0.0.0.0 表示接受所有网卡连接，容器内通常需要该值。
HOST=0.0.0.0
# Node Agent 后端端口；可视化前端默认连接 http://localhost:8100。
PORT=8100

# 留空时所有 Agent 自动进入本地规则/关键词降级模式，项目仍可完整运行。
OPENAI_API_KEY=
# OpenAI 或兼容服务的 API 根地址。程序不会自动加载本 .env 文件，需要在 shell 中导出。
OPENAI_BASE_URL=https://api.openai.com/v1
# Chat 模型用于意图结构化分类、Query 改写/重排/回答、工单分析和深层合规。
MODEL_NAME=gpt-4o
# Embedding 模型只用于把查询和文档转换为向量，不负责生成答案。
EMBEDDING_MODEL=text-embedding-3-small
# 单次 Chat 模型调用超时；超时后对应 Agent 会按自身策略降级。
LLM_TIMEOUT_MS=15000

# 配置后 ShortTermMemory 使用 Redis；留空或连接失败时使用当前进程的 Map。
REDIS_URL=redis://localhost:6379/0
# 每个 session 最多保留的用户/助手消息总数，不是“对话轮数乘二”。
SHORT_TERM_MAX_TURNS=20
# 短期会话过期时间（秒）；每次写入消息都会刷新 TTL。
SHORT_TERM_TTL_SECONDS=1800

# OpenTelemetry 服务名，用于在 Jaeger/Collector 中区分来源服务。
OTEL_SERVICE_NAME=smart-cs-node
# 配置后导出真实 Span；留空时仍记录 /api/metrics 中的进程内聚合指标。
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
